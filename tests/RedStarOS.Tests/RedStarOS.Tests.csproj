<Project Sdk="Microsoft.NET.Sdk">
  <!-- Automated checks: dotnet test tests/RedStarOS.Tests  (or ./check.sh from the repository root) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C# 12, the language of .NET 8's SDK, whichever SDK builds it (the Arch packages use a newer one) -->
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 (required by Avalonia.Headless.XUnit 12): test projects are programs -->
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <!-- screenshots draw with Skia, which needs HarfBuzz for text in Avalonia 12 -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RedStarOS\RedStarOS.csproj" />
  </ItemGroup>
  <!-- Our apps (apps/planner, apps/archive): their engines and windows, tested and pictured with the shell's (their
       Program and App are left out: the tests run as the shell's app, with the same styles) -->
  <ItemGroup>
    <Compile Include="../../apps/planner/src/Model/*.cs" Link="Planner/Model/%(Filename)%(Extension)" />
    <Compile Include="../../apps/planner/src/Views/*.cs" Link="Planner/Views/%(Filename)%(Extension)" />
    <Compile Include="../../apps/archive/src/Model/*.cs" Link="Archive/Model/%(Filename)%(Extension)" />
    <Compile Include="../../apps/archive/src/Views/*.cs" Link="Archive/Views/%(Filename)%(Extension)" />
    <Compile Include="../../apps/shared/Deck.cs" Link="Apps/Deck.cs" />
  </ItemGroup>
</Project>
