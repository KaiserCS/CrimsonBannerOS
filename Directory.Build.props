<Project>
  <PropertyGroup>
    <!-- Every package, direct or not, at an exact version with its content hash (packages.lock.json next to each
         project): what the build uses is written down in the repository, and the local feed (tools/packages.sh)
         holds exactly that. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- No package may change behind our backs: on CI, and with REDSTAR_LOCKED=1 (tools/packages.sh sets it), the lock
         files must match. After changing a package version, run tools/packages.sh fill and commit the lock files. -->
    <RestoreLockedMode Condition="'$(CI)' == 'true' Or '$(REDSTAR_LOCKED)' == '1'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
