# SPDX-License-Identifier: GPL-3.0-or-later
# How the installer looks: Crimson Banner OS's name, its red and dark panels, and the slides shown while it installs.
---
componentName:  crimson
welcomeStyleCalamares:   false
welcomeExpandingLogo:   true
windowExpanding:    normal
windowSize: 960px,620px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "Crimson Banner OS"
    shortProductName:    "Crimson Banner"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Crimson Banner OS @VERSION@ (@VARIANT_TITLE@)"
    shortVersionedName:  "Crimson Banner @VERSION@"
    bootloaderEntryName: "Crimson Banner OS"
    productUrl:          "https://github.com/KaiserCS/CrimsonBannerOS"
    supportUrl:          "https://github.com/KaiserCS/CrimsonBannerOS/issues"
    knownIssuesUrl:      "https://github.com/KaiserCS/CrimsonBannerOS/issues"
    releaseNotesUrl:     "https://github.com/KaiserCS/CrimsonBannerOS/blob/main/CHANGELOG.md"

images:
    productIcon:         "logo.png"
    productLogo:         "logo.png"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:        "#141416"
   SidebarText:              "#E8E9EC"
   SidebarTextCurrent:       "#FFFFFF"
   SidebarBackgroundCurrent: "#C4141C"

slideshow:               "show.qml"
slideshowAPI: 2
