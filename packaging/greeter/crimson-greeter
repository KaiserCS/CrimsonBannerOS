#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Crimson Banner OS's login screen, as greetd starts it (/etc/greetd/config.toml, written by crimson-greeter-setup):
# redstar-comp on this console, with the shell's login screen (RedStarOS --greeter) inside it.
#
# If that fails to come up twice in a row (graphics redstar-comp can't drive, such as a VM's without 3D), the same
# login screen runs on X11 instead. If that fails twice too, greetd's text login (agreety) is used until the computer
# restarts, so a broken login screen can never lock anyone out. greetd starts this again after every session ends.
RUN="${CRIMSON_GREETER_RUN:-/run/crimson-greeter}"
CACHE="${CRIMSON_GREETER_CACHE:-/var/cache/crimson-greeter}"
FAILS="$RUN/failures"
fails="$(cat "$FAILS" 2>/dev/null || echo 0)"
case "$fails" in ''|*[!0-9]*) fails=0 ;; esac

if [ "$fails" -ge 4 ]; then
  echo "Crimson Banner OS's login screen didn't start ($fails tries); using the text login until the next restart."
  echo "Its logs: $CACHE/greeter.log (Wayland), $CACHE/greeter-x11.log (X11)"
  exec agreety --cmd "${CRIMSON_GREETER_FALLBACK:-/bin/sh -l}"
fi

# the login screen's own home: it keeps nothing of anyone's
export HOME="$CACHE" XDG_CONFIG_HOME="$CACHE/config" XDG_CACHE_HOME="$CACHE/cache" XDG_DATA_HOME="$CACHE/data"
export CRIMSON_GREETER_STATE="$CACHE/state.json"
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

start="$(date +%s)"
XORG="${CRIMSON_GREETER_XORG:-/usr/bin/Xorg}"
# no KMS display device (/dev/dri/card*: only an old frame buffer, as on QEMU's VMware adapter): redstar-comp has
# nothing to draw on, so X11 straight away instead of two failed tries first
kms=no
for c in "${CRIMSON_GREETER_DRI:-/dev/dri}"/card*; do [ -e "$c" ] && kms=yes && break; done
if { [ "$fails" -ge 2 ] || [ "$kms" = no ]; } && command -v xinit >/dev/null 2>&1 && [ -x "$XORG" ]; then
  # X11: its own display, on the console greetd gave the login screen
  xinit /usr/lib/crimson-banner/RedStarOS --greeter -- "$XORG" :7 "vt${XDG_VTNR:-1}" -nolisten tcp -keeptty \
    >"$CACHE/greeter-x11.log" 2>&1
  code=$?
else
  redstar-comp -- /usr/lib/crimson-banner/RedStarOS --greeter >"$CACHE/greeter.log" 2>&1
  code=$?
fi
if [ "$code" -eq 0 ]; then
  echo 0 > "$FAILS" 2>/dev/null
elif [ $(( $(date +%s) - start )) -lt 20 ]; then
  # gone within seconds without anyone signing in: count it
  echo $(( fails + 1 )) > "$FAILS" 2>/dev/null
fi
exit "$code"
