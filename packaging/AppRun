#!/bin/sh
# AppImage entry point.
HERE="$(dirname "$(readlink -f "$0")")"
# Self-contained .NET app: no system .NET and no libicu needed.
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
export DOTNET_BUNDLE_EXTRACT_BASE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/redstaros-dotnet"
exec "$HERE/usr/bin/RedStarOS" "$@"
