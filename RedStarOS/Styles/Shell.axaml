<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- =====================================================================================
       Red Star OS design tokens + shared styles.
       Every window and panel takes its colours, type sizes and shapes from here,
       so the whole system looks like one product. Accent colour: ThemeService (Settings > Appearance).
       Taskbar and tray stay a dark glass strip in both themes; flyouts and windows follow the theme.
       ===================================================================================== -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellCardBrush" Color="#0C000000" />
          <SolidColorBrush x:Key="ShellHoverBrush" Color="#10000000" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="ShellToastBrush" Color="#F7FFFFFF" />
          <!-- panels (the deck look, light): a soft grey backdrop, white panels lifted off it -->
          <LinearGradientBrush x:Key="ShellBackdropBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F6F6F8" Offset="0" />
            <GradientStop Color="#E8E8EC" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="ShellPanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ShellPanelBorderBrush" Color="#17000000" />
          <SolidColorBrush x:Key="ShellRuleBrush" Color="#14000000" />
          <SolidColorBrush x:Key="ShellMutedBrush" Color="#686B71" />
          <SolidColorBrush x:Key="ShellFieldBrush" Color="#0A000000" />
          <!-- every standard control (Fluent's own keys): white controls with a hairline, on the pale backdrop -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F2F5" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E8E8EC" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F4F4F6" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#21000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#29000000" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2B000000" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#42000000" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F2F2F5" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#21000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33000000" />
          <!-- flyouts, menus and drop-down lists: a white panel with a hairline -->
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FAFFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FAFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FAFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellCardBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="ShellHoverBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="ShellToastBrush" Color="#F72B2B2B" />
          <!-- panels (the deck look, as CD Player's): graphite backdrop, panels in dark plastic -->
          <LinearGradientBrush x:Key="ShellBackdropBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1C1C1F" Offset="0" />
            <GradientStop Color="#09090A" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="ShellPanelBrush" Color="#0EFFFFFF" />
          <SolidColorBrush x:Key="ShellPanelBorderBrush" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="ShellRuleBrush" Color="#16FFFFFF" />
          <SolidColorBrush x:Key="ShellMutedBrush" Color="#969AA0" />   <!-- 5.2:1 on a panel, 6:1 on the backdrop (DESIGN.md) -->
          <SolidColorBrush x:Key="ShellFieldBrush" Color="#4D000000" />
          <!-- every standard control (Fluent's own keys): the deck's plastic, and fields sunk into it -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#40000000" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#52000000" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#66000000" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2AFFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF" />
          <!-- flyouts, menus and drop-down lists: a graphite panel with a hairline, as the deck's -->
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F51C1C20" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F51C1C20" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F51C1C20" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- every control's corners (Fluent's keys): rounder, as the panels -->
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <Thickness x:Key="ButtonPadding">14,7,14,7</Thickness>

      <!-- Fallbacks: ThemeService replaces these with the user's accent colour at start-up. -->
      <SolidColorBrush x:Key="ShellAccentBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#3A0078D4" />
      <!-- the accent for small text: lightened on dark (the accent itself is under 3:1 on graphite), as is on light -->
      <SolidColorBrush x:Key="ShellAccentTextBrush" Color="#73B5E7" />
      <SolidColorBrush x:Key="ShellFocusBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="RedStarBrush" Color="#C8102E" />
      <SolidColorBrush x:Key="ShellDangerBrush" Color="#E81123" />

      <!-- Taskbar (always dark glass) -->
      <SolidColorBrush x:Key="TaskbarBrush" Color="#EB16161A" />
      <SolidColorBrush x:Key="TaskbarBorderBrush" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="TaskbarHoverBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="TaskbarPressedBrush" Color="#16FFFFFF" />
      <SolidColorBrush x:Key="TaskbarActiveBrush" Color="#33FFFFFF" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== Every window: the deck's backdrop (a window that sets its own background keeps it) ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource ShellBackdropBrush}" />
  </Style>

  <!-- ===== Every list: a panel (unless it sets its own background), rounded rows, the chosen one in a soft wash of
       the accent rather than a solid block (lists with classes of their own, as the desktop's, keep theirs) ===== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>

  <!-- ===== Typography: one scale for every window ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>
  <!-- a section's label: small spaced capitals, as the deck's (write the text in capitals) -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="{DynamicResource RedStarBrush}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <!-- a card is a panel lifted off the backdrop (the same as Border.panel, with less room inside) -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Flyouts (Start menu, quick settings, notifications, calendar) -->
  <Style Selector="FlyoutPresenter.shell">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="900" />
    <Setter Property="MaxHeight" Value="900" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===== Keyboard focus: whatever Tab moved to gets a clear accent outline (mouse clicks don't show it) ===== -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource ShellFocusBrush}" CornerRadius="5" Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Grid.spaced > :is(Control)">
    <Setter Property="Margin" Value="2" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>

  <!-- Quick-setting tile (flyouts). ".on" = active, filled with the accent colour. -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>
  <Style Selector="Button.tile.on">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- ===== Taskbar and tray ===== -->
  <Style Selector="Border.taskbar">
    <Setter Property="Background" Value="{DynamicResource TaskbarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TaskbarBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>

  <Style Selector="Button.task">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.task:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task.active">
    <Setter Property="Background" Value="{DynamicResource TaskbarActiveBrush}" />
  </Style>
  <Style Selector="Button.task.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarActiveBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
  </Style>
  <Style Selector="Button.task.start">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.task.start /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.task.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- ===== Toasts ===== -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ShellToastBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ===== Show desktop: the taskbar's corner sliver ===== -->
  <Style Selector="Button.showdesktop">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource TaskbarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.showdesktop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="Button.showdesktop:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>

  <!-- ===== The clock's panel: round days, quiet buttons ===== -->
  <Style Selector="Button.calday:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.calday.today:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.calday:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <Style Selector="Button.calnav, Button.calfoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.calnav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.calfoot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="Button.callink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.callink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>

  <!-- ===== Taskbar previews ===== -->
  <Style Selector="FlyoutPresenter.preview">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.previewcard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.previewcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.previewclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.previewclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>

  <!-- ===== Snap Assist's cards ===== -->
  <Style Selector="Button.snapcard">
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.snapcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2BFFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- ===== Desktop icons ===== -->
  <Style Selector="ListBox.desktop ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- ===== Settings hub tiles ===== -->
  <Style Selector="Button.hubtile">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="104" />
    <Setter Property="Height" Value="92" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hubtile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>

  <!-- =====================================================================================
       Panels: CD Player's deck look for every window, in light and dark. A backdrop (ShellBackdropBrush) with
       panels lifted off it, small spaced capitals for labels (kicker), pill buttons, and a dark display with red
       digits for figures (lcd). Software uses them first; Styles/Deck.axaml keeps CD Player's own, always dark.
       ===================================================================================== -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector="Button.panel">
    <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.panel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.panel:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
  </Style>

  <Style Selector="TextBlock.kicker">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.kicker.accent">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <!-- pills: the deck's buttons. .accent is filled with the accent colour; .on is the chosen one of a set -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
  </Style>
  <Style Selector="Button.pill.on">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
  </Style>
  <Style Selector="Button.pill.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ShellAccentTextBrush}" />
  </Style>
  <Style Selector="Button.pill.accent">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.pill.large">
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- a small label in a pill (a program's source, a count) -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.badge.accent TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBox.pill-field">
    <Setter Property="Background" Value="{DynamicResource ShellFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- the display: dark glass with red digits, in both themes (it's a display, like the deck's) -->
  <Style Selector="Border.lcd">
    <Setter Property="Background" Value="#F00C0C0E" />
    <Setter Property="BorderBrush" Value="#99000000" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="TextBlock.lcd-label">
    <Setter Property="Foreground" Value="#B3C4141C" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.lcd-digits">
    <Setter Property="Foreground" Value="#F02028" />
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Liberation Mono, monospace" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Effect">
      <DropShadowEffect Color="#CCC4141C" BlurRadius="8" OffsetX="0" OffsetY="0" />
    </Setter>
  </Style>

  <!-- a status pill: a dot and a word (READY, READING FLATHUB…) -->
  <Style Selector="Border.status">
    <Setter Property="Background" Value="{DynamicResource ShellFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Border.status TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <!-- a sidebar's places: the chosen one lit, with an accent bar (set in code) -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>
  <Style Selector="Button.nav.on">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
