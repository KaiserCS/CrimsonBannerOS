<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- =====================================================================================
       Red Star OS design tokens + shared styles.
       Every window and panel takes its colours, type sizes and shapes from here,
       so the whole system looks like one product. Accent colour: ThemeService (Settings > Appearance).
       Taskbar and tray stay a dark glass strip in both themes; flyouts and windows follow the theme.
       ===================================================================================== -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellCardBrush" Color="#0C000000" />
          <SolidColorBrush x:Key="ShellHoverBrush" Color="#10000000" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="ShellToastBrush" Color="#F7FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellCardBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="ShellHoverBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="ShellToastBrush" Color="#F72B2B2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Fallbacks: ThemeService replaces these with the user's accent colour at start-up. -->
      <SolidColorBrush x:Key="ShellAccentBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#3A0078D4" />
      <SolidColorBrush x:Key="ShellFocusBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="RedStarBrush" Color="#C8102E" />
      <SolidColorBrush x:Key="ShellDangerBrush" Color="#E81123" />

      <!-- Taskbar (always dark glass) -->
      <SolidColorBrush x:Key="TaskbarBrush" Color="#EB16161A" />
      <SolidColorBrush x:Key="TaskbarBorderBrush" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="TaskbarHoverBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="TaskbarPressedBrush" Color="#16FFFFFF" />
      <SolidColorBrush x:Key="TaskbarActiveBrush" Color="#33FFFFFF" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== Typography: one scale for every window ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="{DynamicResource RedStarBrush}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Flyouts (Start menu, quick settings, notifications, calendar) -->
  <Style Selector="FlyoutPresenter.shell">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="900" />
    <Setter Property="MaxHeight" Value="900" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===== Keyboard focus: whatever Tab moved to gets a clear accent outline (mouse clicks don't show it) ===== -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource ShellFocusBrush}" CornerRadius="5" Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Grid.spaced > :is(Control)">
    <Setter Property="Margin" Value="2" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>

  <!-- Quick-setting tile (flyouts). ".on" = active, filled with the accent colour. -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>
  <Style Selector="Button.tile.on">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- ===== Taskbar and tray ===== -->
  <Style Selector="Border.taskbar">
    <Setter Property="Background" Value="{DynamicResource TaskbarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TaskbarBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>

  <Style Selector="Button.task">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.task:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task.active">
    <Setter Property="Background" Value="{DynamicResource TaskbarActiveBrush}" />
  </Style>
  <Style Selector="Button.task.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarActiveBrush}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.task.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
  </Style>
  <Style Selector="Button.task.start">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.task.start /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.task.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- ===== Toasts ===== -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ShellToastBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ===== Desktop icons ===== -->
  <Style Selector="ListBox.desktop ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- ===== Settings hub tiles ===== -->
  <Style Selector="Button.hubtile">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="104" />
    <Setter Property="Height" Value="92" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hubtile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
  </Style>
</Styles>
