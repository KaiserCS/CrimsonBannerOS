<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Used inside Red Star's own display / session when no compositor is running. Popups (Start menu, tray panels,
       menus, tooltips) are separate windows there, and without a compositor their transparent rounded corners come
       out black, so they are drawn square and fully opaque instead. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="FlyoutPresenter.shell">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
</Styles>
