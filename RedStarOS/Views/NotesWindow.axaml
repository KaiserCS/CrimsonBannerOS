<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.NotesWindow"
        Title="Notes"
        Width="780" Height="520" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="270,*">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16,16,8,16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="SearchBox" PlaceholderText="Search notes" MinHeight="36" CornerRadius="10"
                 VerticalContentAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="＋" FontSize="18" Width="40" Height="36" Padding="0"
                Margin="8,0,0,0" ToolTip.Tip="New note (Ctrl+N)" Click="OnNew" />
      </Grid>
      <TextBlock x:Name="CountLabel" Grid.Row="1" Classes="eyebrow" Margin="4,12,0,6" />
      <ListBox x:Name="NoteList" Grid.Row="2" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2,4">
              <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding DateText}" Classes="caption" Margin="8,0,0,0" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Preview}" Classes="caption"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="8,16,16,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button x:Name="PinButton" Classes="flat" Content="📌 Pin" Click="OnPin" />
        <Button Grid.Column="1" Classes="flat" Content="🗑 Delete" Click="OnDelete" />
        <TextBlock x:Name="StatusLabel" Grid.Column="3" Classes="caption" VerticalAlignment="Center" />
      </Grid>

      <TextBox x:Name="Editor" Grid.Row="1" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"
               FontSize="15" VerticalContentAlignment="Top" CornerRadius="10" Padding="14" />

      <Border x:Name="UndoBar" Grid.Row="2" Classes="card" Margin="0,8,0,0" Padding="12,6" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Note deleted." VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="flat" Content="Undo" Click="OnUndo" />
        </Grid>
      </Border>

      <TextBlock x:Name="WordLabel" Grid.Row="3" Classes="caption" Margin="4,8,0,0" />
    </Grid>
  </Grid>
</Window>
