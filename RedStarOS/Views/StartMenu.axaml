<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:svc="using:RedStarOS.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:RedStarOS.Views"
             x:Class="RedStarOS.Views.StartMenu"
             Width="750" Height="600" MinWidth="360" MinHeight="380">
  <UserControl.Styles>
    <!-- spacing follows a 4/8 px grid -->
    <Style Selector="ListBox.rail ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.apps ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- group headings in the list can't be selected or launched -->
    <Style Selector="ListBox.apps ListBoxItem">
      <Setter Property="IsEnabled" Value="{Binding IsApp}" />
    </Style>
    <!-- search's best match, which Enter opens -->
    <Style Selector="Border.tophit">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Button.pintile">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="86" />
      <Setter Property="Padding" Value="4,8,4,4" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ToggleButton.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.section:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.footer">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20,20,20,16">

    <TextBox x:Name="SearchBox" PlaceholderText="Search apps, files, settings and the web" FontSize="14" MinHeight="40"
             Padding="4,10" CornerRadius="10" Margin="0,0,0,16" VerticalContentAlignment="Center">
      <TextBox.InnerLeftContent>
        <v:IconView Kind="search" Size="16" Margin="14,0,8,0" VerticalAlignment="Center" Opacity="0.6" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="270,Auto,*">

      <!-- Category rail: our apps and installed Linux apps are kept apart, one tab each -->
      <Grid x:Name="Rail" RowDefinitions="Auto,*">
        <Border x:Name="SectionTabs" CornerRadius="10" Padding="4" Margin="0,0,16,12"
                Background="{DynamicResource ShellCardBrush}">
          <Grid ColumnDefinitions="*,*">
            <ToggleButton x:Name="RsTab" Classes="section" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Padding="4,6" CornerRadius="6" ToolTip.Tip="Crimson Banner's own apps" AutomationProperties.Name="Our apps">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <ContentControl x:Name="RsTabIcon" VerticalAlignment="Center" />
                <TextBlock Text="Our apps" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="LinuxTab" Grid.Column="1" Classes="section" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Padding="4,6" CornerRadius="6" ToolTip.Tip="Linux apps installed on this computer" AutomationProperties.Name="Linux apps">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <ContentControl x:Name="LinuxTabIcon" VerticalAlignment="Center" />
                <TextBlock Text="Linux apps" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,16,0">
            <ListBox x:Name="RsCats" Classes="rail" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="caption"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="LinuxCats" Classes="rail" Background="Transparent" BorderThickness="0" IsVisible="False"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="caption"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="RailRule" Grid.Column="1" Width="1" Background="{DynamicResource ShellBorderBrush}" Margin="0,4" />

      <!-- App list -->
      <Grid x:Name="AppColumn" Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="16,0,0,0">
        <TextBlock x:Name="HeaderLabel" Classes="kicker" Margin="10,6,0,12" />
        <!-- Home: the apps you pinned to Start, as tiles; your recent apps follow in the list below -->
        <StackPanel x:Name="HomePanel" Grid.Row="1" IsVisible="False" Margin="0,0,0,6">
          <WrapPanel x:Name="PinGrid" />
          <TextBlock x:Name="PinHint" Classes="caption" Margin="10,2,0,8" TextWrapping="Wrap"
                     Text="Right-click any app and choose Pin to Start to keep it here." />
        </StackPanel>
        <ListBox x:Name="AppList" Grid.Row="2" Classes="apps" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Panel>
                <!-- group heading in search results ("OUR APPS", "LINUX APPS", …) -->
                <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeader}" Classes="kicker" Margin="0,12,0,4" />
                <Border Classes.tophit="{Binding IsTop}" CornerRadius="10" Margin="-6,0,0,0" Padding="6,0,8,0" IsVisible="{Binding IsApp}">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                  <Panel Width="40" Height="40" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Badge}" BorderBrush="#1FFFFFFF" BorderThickness="1" IsVisible="{Binding ShowBadge}">
                      <ContentControl Content="{Binding Glyph, Converter={x:Static svc:IconConverter.White}, ConverterParameter=20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="36" Height="36"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Panel>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- the best match: Enter opens it -->
                  <Border Grid.Column="2" IsVisible="{Binding IsTop}" Classes="keycap" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Enter" FontSize="11" />
                  </Border>
                </Grid>
                </Border>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyLabel" Grid.Row="2" Text="No apps found" IsVisible="False" Classes="caption"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ShellBorderBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- you: your photo and name, which open your account in Settings -->
        <Button x:Name="AccountButton" Classes="flat" Padding="4,4,12,4" Click="OnAccount" MaxWidth="360"
                ToolTip.Tip="Your account: photo, password and account type" AutomationProperties.Name="Your account">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
              <Image x:Name="AvatarImage" Source="avares://RedStarOS/Assets/avatar.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="UserLabel" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="flat footer" Click="OnSettings">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:IconView Kind="settings" Size="16" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="flat footer">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:IconView Kind="power" Size="16" /><TextBlock Text="Power" VerticalAlignment="Center" /><v:IconView Kind="chevron-down" Size="12" /></StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight">
              <MenuItem Header="Lock" Click="OnLock" />
              <MenuItem Header="Log off" Click="OnLogOff" />
              <MenuItem Header="Restart" Click="OnRestart" />
              <MenuItem Header="Shut down" Click="OnShutdown" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
