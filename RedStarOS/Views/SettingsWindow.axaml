<Window xmlns="https://github.com/avaloniaui"
             xmlns:svc="using:RedStarOS.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.SettingsWindow"
        Title="System Settings"
        Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="224,*">
    <!-- the sidebar, as Software's: the name on top, the places below, a hairline to the page -->
    <Border BorderBrush="{DynamicResource ShellRuleBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="10,0,0,16">
          <TextBlock Classes="kicker accent" Text="CRIMSON BANNER OS" />
          <TextBlock Classes="h1" Text="Settings" />
        </StackPanel>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="11" Margin="2,3">
                <Border Width="28" Height="28" CornerRadius="8" Background="{Binding Color}">
                  <ContentControl Content="{Binding Glyph, Converter={x:Static svc:IconConverter.White}, ConverterParameter=16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <ContentControl x:Name="Page" Margin="28,22" />
    </ScrollViewer>
  </Grid>
</Window>
