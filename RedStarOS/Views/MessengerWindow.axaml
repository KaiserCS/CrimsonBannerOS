<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.MessengerWindow"
        Title="Red Star Messenger"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto" Margin="16">
    <TextBlock Text="Family Chatroom" Classes="h1" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Clear History" Click="OnClear" />
      <Button Content="Leave Group" Click="OnLeave" />
    </StackPanel>

    <ListBox x:Name="Messages" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8" ToolTip.Tip="Double-click a message with a link to open it" />

    <TextBox x:Name="Input" Grid.Row="2" Height="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,8,0" />
    <Button Grid.Row="2" Grid.Column="1" Content="Send Message" Classes="primary" Height="48" Padding="16,0"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSend" />
  </Grid>
</Window>
