<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.CalendarWindow"
        Title="Calendar"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="Auto,*" Margin="16">
    <Calendar x:Name="MonthCalendar" VerticalAlignment="Top" />
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="16,0,0,0">
      <TextBlock x:Name="DateLabel" Classes="h1" TextWrapping="Wrap" />
      <ListBox x:Name="EventList" Grid.Row="1" Margin="0,8" />
      <Grid Grid.Row="2" Classes="spaced" ColumnDefinitions="*,80,Auto">
        <TextBox x:Name="TitleBox" PlaceholderText="New event" />
        <TextBox x:Name="TimeBox" Grid.Column="1" PlaceholderText="HH:mm" />
        <Button Grid.Column="2" Content="Add" Classes="primary" Padding="14,6" Click="OnAdd" />
      </Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Delete selected" Click="OnDelete" />
        <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Classes="caption" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
