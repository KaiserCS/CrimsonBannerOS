<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.ClockWindow"
        Title="Clock"
        Width="420" Height="440" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <TabControl Margin="12">
    <TabItem Header="Stopwatch">
      <StackPanel Spacing="14" Margin="0,20" HorizontalAlignment="Center">
        <TextBlock x:Name="SwLabel" FontSize="56" FontWeight="Light" Text="00:00.00" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button x:Name="SwStart" Classes="primary" Content="Start" MinWidth="96" Padding="0,8" Click="OnSwStart" />
          <Button x:Name="SwLap" Content="Lap" MinWidth="96" Padding="0,8" HorizontalContentAlignment="Center" Click="OnSwLap" />
          <Button Content="Reset" MinWidth="96" Padding="0,8" HorizontalContentAlignment="Center" Click="OnSwReset" />
        </StackPanel>
        <ListBox x:Name="Laps" Height="120" Background="Transparent" />
      </StackPanel>
    </TabItem>

    <TabItem Header="Timer">
      <StackPanel Spacing="14" Margin="0,20" HorizontalAlignment="Center">
        <TextBlock x:Name="TimerLabel" FontSize="56" FontWeight="Light" Text="05:00" HorizontalAlignment="Center" />
        <StackPanel x:Name="TimerInputs" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <NumericUpDown x:Name="MinBox" Minimum="0" Maximum="999" Value="5" Width="110" FormatString="0" />
          <TextBlock Text="min" VerticalAlignment="Center" />
          <NumericUpDown x:Name="SecBox" Minimum="0" Maximum="59" Value="0" Width="110" FormatString="0" />
          <TextBlock Text="sec" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button x:Name="TimerStart" Classes="primary" Content="Start" MinWidth="110" Padding="0,8" Click="OnTimerStart" />
          <Button Content="Reset" MinWidth="110" Padding="0,8" HorizontalContentAlignment="Center" Click="OnTimerReset" />
        </StackPanel>
        <TextBlock Text="A notification appears when the timer ends. You can minimise this window, but keep it open." Classes="caption"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
