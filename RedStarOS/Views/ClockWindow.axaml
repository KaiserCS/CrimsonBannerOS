<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:RedStarOS.Views"
        x:Class="RedStarOS.Views.ClockWindow"
        Title="Clock"
        Width="440" Height="500" MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18,16,18,18">
    <v:AppHeader DockPanel.Dock="Top" AppId="clock" Heading="Clock" />
    <TabControl Padding="0">
      <TabItem Header="Stopwatch">
        <DockPanel Margin="0,18,0,0">
          <StackPanel DockPanel.Dock="Top" Spacing="16">
            <TextBlock x:Name="SwLabel" FontSize="56" FontWeight="Light" Text="00:00.00" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button x:Name="SwStart" Classes="primary" Content="Start" MinWidth="96" Padding="0,8" HorizontalContentAlignment="Center" Click="OnSwStart" />
              <Button x:Name="SwLap" Content="Lap" MinWidth="96" Padding="0,8" HorizontalContentAlignment="Center" Click="OnSwLap" />
              <Button Content="Reset" MinWidth="96" Padding="0,8" HorizontalContentAlignment="Center" Click="OnSwReset" />
            </StackPanel>
            <TextBlock Text="LAPS" Classes="kicker" Margin="0,6,0,0" />
          </StackPanel>
          <Border Classes="panel" Padding="4" Margin="0,6,0,0">
            <Panel>
              <ListBox x:Name="Laps" Background="Transparent" />
              <StackPanel x:Name="LapsEmpty" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <v:IconView Kind="clock" Size="22" HorizontalAlignment="Center" Opacity="0.55" />
                <TextBlock Text="No laps yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Press Lap while the stopwatch runs to mark a split." Classes="caption" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Panel>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Timer">
        <StackPanel Spacing="16" Margin="0,18,0,0" HorizontalAlignment="Center">
          <TextBlock x:Name="TimerLabel" FontSize="56" FontWeight="Light" Text="05:00" HorizontalAlignment="Center" />
          <StackPanel x:Name="TimerInputs" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <NumericUpDown x:Name="MinBox" Minimum="0" Maximum="999" Value="5" Width="110" FormatString="0" />
            <TextBlock Text="min" VerticalAlignment="Center" Classes="caption" />
            <NumericUpDown x:Name="SecBox" Minimum="0" Maximum="59" Value="0" Width="110" FormatString="0" />
            <TextBlock Text="sec" VerticalAlignment="Center" Classes="caption" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="TimerStart" Classes="primary" Content="Start" MinWidth="110" Padding="0,8" HorizontalContentAlignment="Center" Click="OnTimerStart" />
            <Button Content="Reset" MinWidth="110" Padding="0,8" HorizontalContentAlignment="Center" Click="OnTimerReset" />
          </StackPanel>
          <TextBlock Text="A notification appears when the timer ends. You can minimise this window, but keep it open." Classes="caption"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
