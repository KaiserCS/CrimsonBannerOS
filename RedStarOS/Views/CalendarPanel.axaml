<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RedStarOS.Views.CalendarPanel"
             Width="340">
  <!-- The clock's panel: the time, a month to pick a day from, and that day's events. Built in code (CalendarPanel.axaml.cs). -->
  <StackPanel x:Name="Root" Margin="18,16,18,14" Spacing="14" />
</UserControl>
