<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:RedStarOS.Views"
        x:Class="RedStarOS.Views.SlidesWindow"
        Title="Untitled - Slides"
        Width="1320" Height="820" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <!-- The office apps' one construction (OfficeChrome): tabs, menus, one row of tools, the slides, the status bar. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="officetabs">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="tool" Tag="new" Click="OnMenu" ToolTip.Tip="New presentation (Ctrl+N)"><v:IconView Kind="plus" Size="16" /></Button>
        <!-- the one main action: present -->
        <Button DockPanel.Dock="Right" Classes="primary" Tag="present" Click="OnMenu" ToolTip.Tip="Present from the beginning (F5)" Margin="0,0,8,4" Padding="12,5">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:IconView Kind="play" Size="14" /><TextBlock Text="Present" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Spacing="2" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="officebar">
    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_New presentation" Tag="new" InputGesture="Ctrl+N" Click="OnMenu" />
        <MenuItem Header="_Open…" Tag="open" InputGesture="Ctrl+O" Click="OnMenu" />
        <Separator />
        <MenuItem Header="_Save" Tag="save" InputGesture="Ctrl+S" Click="OnMenu" />
        <MenuItem Header="Save _as…" Tag="saveas" InputGesture="Ctrl+Shift+S" Click="OnMenu" />
        <Separator />
        <MenuItem Header="Export as _PDF…" Tag="pdf" Click="OnMenu" />
        <MenuItem Header="Export slides as _images…" Tag="pngs" Click="OnMenu" />
        <Separator />
        <MenuItem Header="_Close" Tag="close" Click="OnMenu" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Tag="undo" InputGesture="Ctrl+Z" Click="OnMenu" />
        <MenuItem Header="_Redo" Tag="redo" InputGesture="Ctrl+Y" Click="OnMenu" />
        <Separator />
        <MenuItem Header="Cu_t" Tag="cut" InputGesture="Ctrl+X" Click="OnMenu" />
        <MenuItem Header="_Copy" Tag="copy" InputGesture="Ctrl+C" Click="OnMenu" />
        <MenuItem Header="_Paste" Tag="paste" InputGesture="Ctrl+V" Click="OnMenu" />
        <MenuItem Header="D_uplicate" Tag="dupitem" InputGesture="Ctrl+D" Click="OnMenu" />
        <MenuItem Header="_Delete (Del)" Tag="delitem" Click="OnMenu" />
      </MenuItem>
      <MenuItem Header="_Slide">
        <MenuItem Header="_New slide" Tag="newslide" InputGesture="Ctrl+M" Click="OnMenu" />
        <MenuItem Header="D_uplicate slide" Tag="dupslide" Click="OnMenu" />
        <MenuItem Header="_Delete slide" Tag="delslide" Click="OnMenu" />
        <Separator />
        <MenuItem Header="Move _up" Tag="slideup" Click="OnMenu" />
        <MenuItem Header="Move _down" Tag="slidedown" Click="OnMenu" />
      </MenuItem>
      <MenuItem Header="_Insert">
        <MenuItem Header="_Text box" Tag="addtext" Click="OnMenu" />
        <MenuItem Header="_Picture…" Tag="addimage" Click="OnMenu" />
        <MenuItem Header="_Shape" Tag="addshape" Click="OnMenu" />
      </MenuItem>
      <MenuItem Header="_Slide show">
        <MenuItem Header="From _beginning" Tag="present" InputGesture="F5" Click="OnMenu" />
        <MenuItem Header="From _current slide" Tag="presentcur" InputGesture="Shift+F5" Click="OnMenu" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="NotesItem" Header="_Speaker notes" Tag="notes" ToggleType="CheckBox" IsChecked="True" Click="OnMenu" />
      </MenuItem>
    </Menu>
    </Border>

    <Border DockPanel.Dock="Top" Classes="officetools">
      <v:OfficeToolbar>
        <Button Classes="tool label" Tag="newslide" Click="OnMenu" ToolTip.Tip="New slide (Ctrl+M)" v:OfficeToolbar.MenuHeader="New slide">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:IconView Kind="plus" Size="16" /><TextBlock Text="New slide" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <ComboBox x:Name="LayoutBox" Width="168" ToolTip.Tip="Layout of new slides" />
        <Button Classes="tool" Tag="dupslide" Click="OnMenu" ToolTip.Tip="Duplicate slide"><v:IconView Kind="copy" Size="18" /></Button>
        <Button Classes="tool" Tag="delslide" Click="OnMenu" ToolTip.Tip="Delete slide"><v:IconView Kind="trash" Size="18" /></Button>
        <Button Classes="tool" Tag="slideup" Click="OnMenu" ToolTip.Tip="Move slide up"><v:IconView Kind="arrow-up" Size="18" /></Button>
        <Button Classes="tool" Tag="slidedown" Click="OnMenu" ToolTip.Tip="Move slide down"><v:IconView Kind="arrow-down" Size="18" /></Button>
        <Border Classes="tbsep" />
        <Button Classes="tool" Tag="addtext" Click="OnMenu" ToolTip.Tip="Text box"><v:IconView Kind="text-box" Size="18" /></Button>
        <Button Classes="tool" Tag="addimage" Click="OnMenu" ToolTip.Tip="Picture"><v:IconView Kind="image" Size="18" /></Button>
        <ComboBox x:Name="ShapeBox" Width="128" ToolTip.Tip="Shape to add" />
        <Button Classes="tool" Tag="addshape" Click="OnMenu" ToolTip.Tip="Add the shape"><v:IconView Kind="shape" Size="18" /></Button>
        <Border Classes="tbsep" />
        <ComboBox x:Name="FontBox" Width="150" ToolTip.Tip="Font" />
        <ComboBox x:Name="SizeBox" Width="68" ToolTip.Tip="Font size" Margin="4,0,0,0" />
        <ToggleButton x:Name="BoldBtn" Classes="tool" ToolTip.Tip="Bold"><v:IconView Kind="bold" Size="18" /></ToggleButton>
        <ToggleButton x:Name="ItalicBtn" Classes="tool" ToolTip.Tip="Italic"><v:IconView Kind="italic" Size="18" /></ToggleButton>
        <ToggleButton x:Name="UnderBtn" Classes="tool" ToolTip.Tip="Underline"><v:IconView Kind="underline" Size="18" /></ToggleButton>
        <Button x:Name="TextColorBtn" Classes="tool" />
        <Border Classes="tbsep" />
        <ToggleButton x:Name="AlignL" Classes="tool" ToolTip.Tip="Align left"><v:IconView Kind="align-left" Size="18" /></ToggleButton>
        <ToggleButton x:Name="AlignC" Classes="tool" ToolTip.Tip="Centre"><v:IconView Kind="align-center" Size="18" /></ToggleButton>
        <ToggleButton x:Name="AlignR" Classes="tool" ToolTip.Tip="Align right"><v:IconView Kind="align-right" Size="18" /></ToggleButton>
        <ToggleButton x:Name="BulletBtn" Classes="tool" ToolTip.Tip="Bulleted list"><v:IconView Kind="list-bullet" Size="18" /></ToggleButton>
        <ComboBox x:Name="VAlignBox" Width="96" ToolTip.Tip="Text position in the box" />
        <Border Classes="tbsep" />
        <Button x:Name="FillBtn" Classes="tool" />
        <Button x:Name="LineBtn" Classes="tool" />
        <ComboBox x:Name="LineWBox" Width="66" ToolTip.Tip="Outline width" />
        <Button Classes="tool" Tag="front" Click="OnMenu" ToolTip.Tip="Bring to front"><v:IconView Kind="bring-front" Size="18" /></Button>
        <Button Classes="tool" Tag="forward" Click="OnMenu" ToolTip.Tip="Bring forward"><v:IconView Kind="arrow-up" Size="18" /></Button>
        <Button Classes="tool" Tag="backward" Click="OnMenu" ToolTip.Tip="Send backward"><v:IconView Kind="arrow-down" Size="18" /></Button>
        <Button Classes="tool" Tag="back" Click="OnMenu" ToolTip.Tip="Send to back"><v:IconView Kind="send-back" Size="18" /></Button>
        <TextBox x:Name="RotBox" Width="64" Text="0" ToolTip.Tip="Rotation (degrees)" Margin="4,0,0,0" />
        <Border Classes="tbsep" />
        <ComboBox x:Name="ThemeBox" Width="120" ToolTip.Tip="Theme" />
        <Button x:Name="BgBtn" Classes="tool" />
        <ComboBox x:Name="TransitionBox" Width="96" ToolTip.Tip="Transition to this slide" Margin="4,0,0,0" />
      </v:OfficeToolbar>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="officestatus">
      <DockPanel>
        <v:OfficeZoom x:Name="Zoom" DockPanel.Dock="Right" />
        <TextBlock x:Name="StatusText" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="200" Classes="officeside">
      <ListBox x:Name="ThumbList" Background="Transparent" Padding="6">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="22,*" Margin="0,2">
              <TextBlock Text="{Binding Number}" Classes="caption" VerticalAlignment="Top" Margin="0,4,0,0" />
              <Border Grid.Column="1" CornerRadius="3" ClipToBounds="True" BorderThickness="1" BorderBrush="#55808080" Background="White">
                <Image Source="{Binding Image}" Stretch="Uniform" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid x:Name="Centre" RowDefinitions="*,Auto">
      <!-- zoom: 100% fits the slide to the window; larger makes the stage bigger and it scrolls -->
      <ScrollViewer x:Name="StageScroll" Background="{DynamicResource ShellFieldBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Stage">
          <v:SlideCanvas x:Name="Surface" />
          <Canvas x:Name="Overlay" />
        </Grid>
      </ScrollViewer>
      <Border x:Name="NotesHost" Grid.Row="1" Classes="officetools" BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Spacing="2">
          <TextBlock Text="Speaker notes" Classes="caption" Margin="2,0,0,2" />
          <TextBox x:Name="NotesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Click to add notes for this slide" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
