<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.CalculatorWindow"
        Title="Calculator"
        Width="300" Height="300" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Classes="spaced" RowDefinitions="Auto,*" Margin="16">
    <TextBox x:Name="Display" Text="0" IsReadOnly="True" TextAlignment="Right" FontSize="20" />
    <Grid Classes="spaced" Grid.Row="1" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*,*">
      <Button Grid.Row="0" Grid.Column="0" Content="7" Tag="7" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="1" Content="8" Tag="8" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="2" Content="9" Tag="9" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="3" Content="/" Tag="/" Click="OnOperator" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="4" Content="CE" Click="OnClearEntry" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

      <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="4" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="5" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="6" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="3" Content="*" Tag="*" Click="OnOperator" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="4" Content="C" Click="OnClearAll" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

      <Button Grid.Row="2" Grid.Column="0" Content="1" Tag="1" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="2" Grid.Column="1" Content="2" Tag="2" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="2" Grid.Column="2" Content="3" Tag="3" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="2" Grid.Column="3" Content="-" Tag="-" Click="OnOperator" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="2" Grid.Column="4" Grid.RowSpan="2" Content="=" Click="OnEquals" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

      <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Tag="0" Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="3" Grid.Column="2" Content="." Tag="." Click="OnDigit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Grid.Row="3" Grid.Column="3" Content="+" Tag="+" Click="OnOperator" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    </Grid>
  </Grid>
</Window>
