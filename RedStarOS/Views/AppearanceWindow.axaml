<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.AppearanceWindow"
        Title="Appearance"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Appearance" Classes="h1" />
    <TextBlock Text="Theme" Classes="eyebrow" />
    <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" />
    <TextBlock Text="ACCENT COLOUR" Classes="eyebrow" Margin="0,8,0,0" />
    <ComboBox x:Name="AccentBox" HorizontalAlignment="Stretch" />
    <CheckBox x:Name="FullscreenCheck" Content="Full-screen desktop (covers the host panel)" Margin="0,10,0,0" />
    <TextBlock Text="Changes apply immediately, including in Red Star Online and Red Star Video." Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" />
  </StackPanel>
</Window>
