<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RedStarOS.Views.Taskbar"
             Height="56">
  <!--
    [Start] [Task View] [pinned + running apps ...] [app tray] | [system tray] [clock] |▌ (show desktop, in the corner)
    - Pinned launchers and running windows share one row: a pinned app that is running is the same button.
    - Native apps and other programs' windows are listed identically.
    - App tray: icons of background things (media controls of Video, other programs' tray icons, ...).
    - Notifications: the bell beside the clock, with the number of unread ones.
    - System tray: network / volume / battery in one button that opens Quick Settings.
  -->
  <Border Classes="taskbar">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="8,0">

      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <Button x:Name="StartButton" Classes="task start banner" Width="44" Height="44" Padding="0"
              ToolTip.Tip="Start (Win key)">
        <Panel>
          <!-- the banner (the default): the desktop's banner, small, hanging from the taskbar's top edge on a short
               rod; it hangs lower while Start is open (styles: Button.task.start.banner in Shell.axaml) -->
          <Canvas x:Name="StartBanner" Width="44" Height="56" Margin="0,-7,0,-5" ClipToBounds="False">
            <Rectangle x:Name="BannerRod" Canvas.Left="4" Canvas.Top="0" Width="36" Height="3" RadiusX="1.5" RadiusY="1.5" />
            <Panel x:Name="BannerHang" Canvas.Left="9" Canvas.Top="2" Width="26" Height="46" RenderTransformOrigin="50%,0%">
              <Path x:Name="BannerCloth" Data="M 0,0 H 26 V 38 L 13,31 L 0,38 Z" Stretch="None" VerticalAlignment="Top">
                <Path.Fill>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#A00B1F" />
                    <GradientStop Offset="0.45" Color="#D8243C" />
                    <GradientStop Offset="1" Color="#A80C22" />
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <!-- lighter when pointed at or open -->
              <Path x:Name="BannerShine" Data="M 0,0 H 26 V 38 L 13,31 L 0,38 Z" Stretch="None" VerticalAlignment="Top" Fill="White" Opacity="0" />
            </Panel>
            <!-- the star rides down with the cloth (it isn't stretched with it) -->
            <Viewbox x:Name="BannerStar" Canvas.Left="14.5" Canvas.Top="9.5" Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Fill="White" Data="M 12,2.2 L 14.6,9.3 L 22.2,9.5 L 16.2,14.1 L 18.3,21.4 L 12,17.1 L 5.7,21.4 L 7.8,14.1 L 1.8,9.5 L 9.4,9.3 Z" />
              </Canvas>
            </Viewbox>
          </Canvas>
          <!-- the round badge (Settings → Desktop & Taskbar can bring it back): white star on a red disc -->
          <Viewbox x:Name="StartBadge" Width="28" Height="28" IsVisible="False">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#E8344B" />
                    <GradientStop Offset="1" Color="#A00B1F" />
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse Canvas.Left="1.6" Canvas.Top="1.6" Width="20.8" Height="20.8" Stroke="#47FFFFFF" StrokeThickness="0.8" />
              <Path Fill="White" Stroke="White" StrokeThickness="0.5" StrokeJoin="Round"
                    Data="M 12,5.3 L 13.76,10.27 L 19.04,10.41 L 14.85,13.63 L 16.35,18.69 L 12,15.7 L 7.65,18.69 L 9.15,13.63 L 4.96,10.41 L 10.24,10.27 Z" />
            </Canvas>
          </Viewbox>
        </Panel>
      </Button>
      <!-- Task View: the open windows and the virtual desktops (Super+Tab) -->
      <Button x:Name="TaskViewButton" Classes="task" Width="44" Height="44" Padding="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              ToolTip.Tip="Task View (Super+Tab)" />
      </StackPanel>

      <DockPanel Grid.Column="1" Margin="10,0">
        <ScrollViewer x:Name="TaskScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TaskList" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </ScrollViewer>
      </DockPanel>

      <!-- App tray -->
      <StackPanel x:Name="AppTray" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

      <Border x:Name="TrayRule" Grid.Column="3" Width="1" Height="26" Margin="8,0" Background="{DynamicResource TaskbarBorderBrush}" IsVisible="False" />

      <!-- System tray + clock -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="SystemTrayButton" Classes="task" Height="40" Padding="10,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ContentControl x:Name="NetGlyph" VerticalAlignment="Center" />
            <ContentControl x:Name="VolumeGlyph" VerticalAlignment="Center" />
            <StackPanel x:Name="BatteryRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
              <ContentControl x:Name="BatteryGlyph" VerticalAlignment="Center" />
              <TextBlock x:Name="BatteryText" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="ClockButton" Classes="task" Height="40" Padding="10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ClockLabel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Text="00:00" />
            <TextBlock x:Name="DateLabel" FontSize="11" Opacity="0.75" HorizontalAlignment="Right" />
          </StackPanel>
        </Button>
        <!-- notifications, by the clock: the number of unread ones on the bell -->
        <Panel x:Name="BellHost" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Show desktop: a sliver in the bottom-right corner, reaching the screen's edge so a flick of the mouse finds
           it; a click hides every window (again, they come back), resting the pointer on it peeks through them -->
      <!-- taskbar previews (TaskPreview): no light dismiss, so nothing covers the buttons while it's open -->
      <Popup x:Name="PreviewPopup" Placement="Top" IsLightDismissEnabled="False" Topmost="True" />

      <Button x:Name="ShowDesktopButton" Grid.Column="5" Classes="showdesktop" Width="14" Margin="6,0,-8,0"
              VerticalAlignment="Stretch" ToolTip.Tip="Show desktop" />
    </Grid>
  </Border>
</UserControl>
