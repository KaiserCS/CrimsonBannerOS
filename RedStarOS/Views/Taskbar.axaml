<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RedStarOS.Views.Taskbar"
             Height="56">
  <!--
    [Start] [pinned + running apps ............] [app tray] | [system tray] [clock] |▌ (show desktop, in the corner)
    - Pinned launchers and running windows share one row: a pinned app that is running is the same button.
    - Native apps and other programs' windows are listed identically.
    - App tray: icons of background things (notifications, media controls of Red Star Video, ...).
    - System tray: network / volume / battery in one button that opens Quick Settings.
  -->
  <Border Classes="taskbar">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="8,0">

      <Button x:Name="StartButton" Classes="task start" Width="44" Height="44" Padding="0"
              ToolTip.Tip="Start (Win key)">
        <!-- Red Star OS badge: white star on a red disc (vector, sharp at any scale) -->
        <Viewbox Width="28" Height="28">
          <Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#E8344B" />
                  <GradientStop Offset="1" Color="#A00B1F" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="1.6" Canvas.Top="1.6" Width="20.8" Height="20.8" Stroke="#47FFFFFF" StrokeThickness="0.8" />
            <Path Fill="White" Stroke="White" StrokeThickness="0.5" StrokeJoin="Round"
                  Data="M 12,5.3 L 13.76,10.27 L 19.04,10.41 L 14.85,13.63 L 16.35,18.69 L 12,15.7 L 7.65,18.69 L 9.15,13.63 L 4.96,10.41 L 10.24,10.27 Z" />
          </Canvas>
        </Viewbox>
      </Button>

      <DockPanel Grid.Column="1" Margin="10,0">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TaskList" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </ScrollViewer>
      </DockPanel>

      <!-- App tray -->
      <StackPanel x:Name="AppTray" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

      <Border Grid.Column="3" Width="1" Height="26" Margin="8,0" Background="{DynamicResource TaskbarBorderBrush}" />

      <!-- System tray + clock -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="SystemTrayButton" Classes="task" Height="40" Padding="10,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ContentControl x:Name="NetGlyph" VerticalAlignment="Center" />
            <ContentControl x:Name="VolumeGlyph" VerticalAlignment="Center" />
            <TextBlock x:Name="BatteryText" FontSize="13" VerticalAlignment="Center" IsVisible="False" />
          </StackPanel>
        </Button>
        <Button x:Name="ClockButton" Classes="task" Height="40" Padding="10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ClockLabel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Text="00:00" />
            <TextBlock x:Name="DateLabel" FontSize="11" Opacity="0.75" HorizontalAlignment="Right" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Show desktop: a sliver in the bottom-right corner, reaching the screen's edge so a flick of the mouse finds
           it; a click hides every window (again, they come back), resting the pointer on it peeks through them -->
      <!-- taskbar previews (TaskPreview): no light dismiss, so nothing covers the buttons while it's open -->
      <Popup x:Name="PreviewPopup" Placement="Top" VerticalOffset="-6" IsLightDismissEnabled="False" Topmost="True" />

      <Button x:Name="ShowDesktopButton" Grid.Column="5" Classes="showdesktop" Width="14" Margin="6,0,-8,0"
              VerticalAlignment="Stretch" ToolTip.Tip="Show desktop" />
    </Grid>
  </Border>
</UserControl>
