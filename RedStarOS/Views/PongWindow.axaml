<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.PongWindow"
        Title="Ping Pong"
        Width="780" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Game">
        <MenuItem Header="_New Game" InputGesture="F1" Click="OnNewGame" />
        <MenuItem Header="_Pause / Resume" InputGesture="P" Click="OnPause" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Escape" Click="OnExitGame" />
      </MenuItem>
      <MenuItem Header="_Mode">
        <MenuItem x:Name="ModeSolo" Header="_Solo - keep the rally going" Click="OnModeSolo" />
        <MenuItem x:Name="ModeAi" Header="_Versus the computer - first to 7" Click="OnModeAi" />
      </MenuItem>
      <MenuItem Header="_Difficulty">
        <MenuItem x:Name="LevelEasy" Header="_Easy" Click="OnLevel" Tag="0" />
        <MenuItem x:Name="LevelNormal" Header="_Normal" Click="OnLevel" Tag="1" />
        <MenuItem x:Name="LevelHard" Header="_Hard" Click="OnLevel" Tag="2" />
        <MenuItem x:Name="LevelExpert" Header="E_xpert" Click="OnLevel" Tag="3" />
      </MenuItem>
    </Menu>

    <Canvas x:Name="Playground" ClipToBounds="True" Background="{DynamicResource ShellCardBrush}">
      <Border x:Name="Net" Height="2" Opacity="0.25" Background="{DynamicResource ShellBorderBrush}" />
      <TextBlock x:Name="ScoreLabel" Canvas.Left="16" Canvas.Top="10" Classes="h1" Text="0" />
      <TextBlock x:Name="BestLabel" Canvas.Top="14" Classes="caption" />
      <Border x:Name="AiRacket" Height="14" CornerRadius="7" Background="{DynamicResource RedStarBrush}" IsVisible="False" />
      <Image x:Name="Ball" Source="avares://RedStarOS/Assets/ball.png" />
      <Border x:Name="Racket" Height="14" CornerRadius="7" Background="{DynamicResource ShellAccentBrush}" />
      <Border x:Name="Overlay" CornerRadius="14" Padding="24,16" Background="#C0141418" IsHitTestVisible="False">
        <TextBlock x:Name="OverlayText" Foreground="White" FontSize="20" TextAlignment="Center" />
      </Border>
    </Canvas>
  </DockPanel>
</Window>
