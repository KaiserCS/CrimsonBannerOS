<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.UpdatesWindow"
        Title="Software Updates"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Software Updates" Classes="h1" />
    <TextBlock x:Name="VersionLabel" />
    <TextBlock Text="UPDATE SOURCE (GITHUB RELEASES API URL)" Classes="eyebrow" Margin="0,8,0,0" />
    <TextBox x:Name="UrlBox" PlaceholderText="https://api.github.com/repos/USER/REPO/releases/latest" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="CheckButton" Content="Check for updates" Classes="primary" Padding="14,8" Click="OnCheck" />
      <Button x:Name="PageButton" Content="Open download page" Click="OnOpenPage" IsVisible="False" />
      <Button x:Name="UpdateButton" Content="Update AppImage" Click="OnUpdate" IsVisible="False" />
    </StackPanel>
    <ProgressBar x:Name="Progress" IsIndeterminate="True" IsVisible="False" />
    <TextBlock x:Name="ResultLabel" TextWrapping="Wrap" />
  </StackPanel>
</Window>
