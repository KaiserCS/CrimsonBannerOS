<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedStarOS.Views.NetworkWindow"
        Title="Network Settings"
        Width="620" Height="400"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <TextBlock Text="Network Settings" Classes="h1" />
    <TextBlock x:Name="HostLabel" Grid.Row="1" Margin="0,4,0,8" />
    <ListBox x:Name="Interfaces" Grid.Row="2" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Content="Refresh" Click="OnRefresh" />
      <Button Content="Wi-Fi networks..." Click="OnWifi" />
      <Button Content="System network settings" Click="OnSystemSettings" />
    </StackPanel>
  </Grid>
</Window>
